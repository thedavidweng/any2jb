{
	"$schema": "https://biomejs.dev/schemas/2.6.6/schema.json",
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true
	},
	"files": {
		"includes": [
			"package.json",
			"biome.json",
			"tsconfig.json",
			"renovate.json",
			"mygo.json",
			"scripts/**/*.mjs",
			"resources/runtime/**/*.cjs",
			"internal/**/*.cjs"
		]
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab",
		"lineWidth": 100
	},
	"linter": {
		"enabled": true,
		"rules": {
			"style": {
				"useNodejsImportProtocol": "error",
				"useTemplate": "off"
			},
			"suspicious": {
				"noExplicitAny": "off",
				"noControlCharactersInRegex": "off"
			}
		}
	},
	"overrides": [
		{
			"includes": ["**/*.cjs"],
			"linter": {
				"rules": {
					"style": {
						"useNodejsImportProtocol": "off"
					}
				}
			}
		}
	]
}
